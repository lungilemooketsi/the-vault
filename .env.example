# Copy the public sandbox client id, secret and x-api-key from the Sandbox
# credentials table. Do not commit the filled-in values.
# https://developer.investec.com/api-reference/SA%20PB%20Account%20Information
# Leave the three secrets empty to run the offline snapshot (VAULT_MODE=mock).

VAULT_MODE=mock
INVESTEC_BASE_URL=https://openapisandbox.investec.com
INVESTEC_CLIENT_ID=
INVESTEC_CLIENT_SECRET=
INVESTEC_API_KEY=
VAULT_WEBHOOK_URL=http://127.0.0.1:8787/vault/events
VAULT_FIXTURE_DIR=matlab/fixtures
